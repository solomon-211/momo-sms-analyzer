{
  "schemas": {
    "transaction_category": {
      "type": "object",
      "properties": {
        "category_id": {"type": "integer"},
        "category_name": {"type": "string", "maxLength": 50},
        "category_code": {"type": "string", "maxLength": 10},
        "description": {"type": "string"},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "required": ["category_id", "category_name", "category_code"]
    },
    "user": {
      "type": "object",
      "properties": {
        "user_id": {"type": "integer"},
        "phone_number": {"type": "string", "maxLength": 15},
        "full_name": {"type": "string", "maxLength": 100},
        "account_number": {"type": "string", "maxLength": 20},
        "balance": {"type": "number", "minimum": 0},
        "status": {"type": "string", "enum": ["active", "inactive", "suspended"]},
        "created_at": {"type": "string", "format": "date-time"},
        "updated_at": {"type": "string", "format": "date-time"}
      },
      "required": ["user_id", "phone_number"]
    },
    "transaction": {
      "type": "object",
      "properties": {
        "transaction_id": {"type": "integer"},
        "tx_id": {"type": "string", "maxLength": 50},
        "sender_id": {"type": "integer"},
        "receiver_id": {"type": "integer"},
        "category_id": {"type": "integer"},
        "amount": {"type": "number", "minimum": 0},
        "fee": {"type": "number", "minimum": 0},
        "balance_after": {"type": "number"},
        "transaction_date": {"type": "string", "format": "date-time"},
        "status": {"type": "string", "enum": ["completed", "pending", "failed", "cancelled"]},
        "message_body": {"type": "string"},
        "service_center": {"type": "string", "maxLength": 20},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "required": ["transaction_id", "tx_id", "category_id", "amount", "transaction_date"]
    },
    "system_log": {
      "type": "object",
      "properties": {
        "log_id": {"type": "integer"},
        "log_level": {"type": "string", "enum": ["INFO", "WARNING", "ERROR", "DEBUG"]},
        "message": {"type": "string"},
        "module": {"type": "string", "maxLength": 50},
        "user_id": {"type": "integer"},
        "transaction_id": {"type": "integer"},
        "ip_address": {"type": "string", "maxLength": 45},
        "created_at": {"type": "string", "format": "date-time"}
      },
      "required": ["log_id", "log_level", "message"]
    }
  },
